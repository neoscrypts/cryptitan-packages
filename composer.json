{
    "name": "neoscrypts/cryptitan",
    "description": "Cryptitan Packages",
    "type": "library",
    "autoload": {
        "files": [
            "src/Multipay/helpers.php",
            "src/Exchanger/helpers.php",
            "src/Installer/helpers.php"
        ],
        "psr-4": {
            "NeoScrypts\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Henry Ogunrinde",
            "email": "info@oluwatosin.me"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-json": "*",
        "illuminate/support" : ">=8.0",
        "illuminate/console" : ">=8.0",
        "illuminate/cache" : ">=8.0",
        "illuminate/database" : ">=8.0",
        "illuminate/http" : ">=8.0",
        "illuminate/routing" : ">=8.0",
        "akaunting/laravel-money": "dev-cryptitan",
        "paypal/paypal-checkout-sdk": "^1.0",
        "stripe/stripe-php": "^7.94",
        "openpayu/openpayu" : "2.3.*",
        "mollie/mollie-api-php": "^2.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/neoscrypts/laravel-money"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "NeoScrypts\\Multipay\\MultipayServiceProvider",
                "NeoScrypts\\Landing\\LandingServiceProvider",
                "NeoScrypts\\Exchanger\\ExchangerServiceProvider",
                "NeoScrypts\\Installer\\InstallerServiceProvider"
            ]
        }
    }
}
